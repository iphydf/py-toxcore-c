"""Writes pytox_client/nodes.py from nodes.tox.chat's list.

The client never fetches the node list itself. Run this before a release.
"""
from __future__ import annotations

import ipaddress
import json
import pathlib
import sys
import urllib.request

URL = "https://nodes.tox.chat/json"
OUT = (pathlib.Path(__file__).resolve().parent.parent /
       "pytox_client/nodes.py")


def is_ip(host: str) -> bool:
    try:
        ipaddress.ip_address(host)
        return True
    except ValueError:
        return False


def main() -> None:
    with urllib.request.urlopen(URL, timeout=60) as response:
        data = json.load(response)
        # Only nodes with an IP address: bootstrapping from a hostname resolves
        # synchronously on the Tox thread.
        nodes = [
            node for node in data["nodes"]
            if node.get("ipv4") and is_ip(node["ipv4"])
        ]

    if (not any(node.get("status_udp") for node in nodes)
            or not any(node.get("status_tcp") for node in nodes)):
        sys.exit(f"{URL} has no working nodes now: try again later")

    lines = []
    for node in nodes:
        if not (node.get("status_udp") or node.get("status_tcp")):
            continue
        tcp = ", ".join(str(p) for p in node["tcp_ports"])
        if len(node["tcp_ports"]) == 1:
            tcp = f"{tcp}, "
        lines.append(
            f"    Node({json.dumps(node['ipv4'])}, {int(node['port'])}, "
            f"({tcp}),\n"
            f"         {json.dumps(node['public_key'])}),"
        )

    entries = "\n".join(lines)
    OUT.write_text(
        "# SPDX-License-Identifier: GPL-3.0-or-later\n"
        "# Copyright © 2026 The TokTok team\n"
        f"# Code generated by tools/update-nodes from {URL}.\n"
        "# Run tools/update-nodes before each release.\n"
        '"""Built-in bootstrap nodes (PyTox never fetches the list at runtime)."""\n'
        "from __future__ import annotations\n\n"
        "from pytox_client.model import Node\n\n"
        "BUILT_IN_NODES: tuple[Node, ...] = (\n"
        f"{entries}\n"
        ")\n",
        encoding="utf-8",
    )


if __name__ == "__main__":
    main()
