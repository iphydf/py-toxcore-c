load("@rules_python//python:defs.bzl", "py_library")
load("//third_party/python:build_defs.bzl", "mypy_test", "pyx_library")
load("//tools/project:build_defs.bzl", "project")

project(license = "gpl3-https")

pyx_library(
    name = "pytox",
    srcs = glob([
        "pytox/**/*.pxd",
        "pytox/**/*.pyx",
        "pytox/**/*.py",
        "pytox/**/*.pyi",
    ]),
    cdeps = ["//c-toxcore"],
    cython_directives = {
        "embedsignature": "True",
        "embedsignature.format": "python",
    },
    tags = ["no-cross"],
    visibility = ["//visibility:public"],
)

mypy_test(
    name = "mypy_test",
    # pytox's own modules, as pytox.*, with the extensions' stubs.
    srcs = glob(["pytox/**/*.py"]),
    path = ["py_toxcore_c"],
    deps = [":pytox"],
)

py_library(
    name = "py_toxcore_c",
    srcs = ["__init__.py"],
    tags = ["no-cross"],
    visibility = ["//visibility:public"],
    deps = [":pytox"],
)
